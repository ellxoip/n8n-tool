# n8n runtime
N8N_USER_FOLDER=./.runtime/n8n
N8N_HOST=localhost
N8N_PORT=5678
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=false
N8N_DIAGNOSTICS_ENABLED=false
# Keep false unless @n8n/task-runner-python is available in your n8n install.
N8N_PYTHON_ENABLED=false

# CLI
N8N_BASE_URL=http://localhost:5678
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CREDENTIAL_NAME=Ollama Local
N8N_TEAM_TIMEOUT_MS=300000
PYTHON_PATH=./.runtime/python311/python.exe

# Only needed for import/update scripts.
# Generate this in n8n and keep it private.
N8N_API_KEY=

# Models: config/models.json picks the first installed candidate per role.
# Force a specific model for a role (any Ollama tag) by uncommenting:
# OLLAMA_MODEL_SUPERVISOR=
# OLLAMA_MODEL_ANALYST=
# OLLAMA_MODEL_PROGRAMMER=
# OLLAMA_MODEL_REVIEWER=
# OLLAMA_MODEL_DEVOPS=
# OLLAMA_MODEL_VISION=
# OLLAMA_MODEL_EMBEDDING=

# Local bridge (Terminal Coder + memory). n8n-tool generates BRIDGE_TOKEN automatically.
BRIDGE_TOKEN=
BRIDGE_PORT=8787
# Folder where Aider/OpenCode are allowed to work. Nothing outside it is touched.
TERMINAL_CODER_WORKSPACE=./workspace
# aider (auto git commits) or opencode
TERMINAL_CODER_ENGINE=aider
TERMINAL_CODER_TIMEOUT_MS=600000
# Test commands the agent may run after a task, separated by ";". Empty = built-in list
# (npm test; npm run lint; pytest -q; python -m pytest -q; go test ./...; cargo test).
TERMINAL_CODER_ALLOWED_TESTS=

# Memory (Qdrant: docker compose up -d qdrant)
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=n8n_team_memory
# QDRANT_API_KEY=

# Voice (docker compose --profile voice up -d). Any OpenAI-compatible server works,
# e.g. your own Qwen3-TTS server: just point TTS_BASE_URL / TTS_MODEL / TTS_VOICE at it.
# TTS_BASE_URL=http://127.0.0.1:8880
# TTS_MODEL=kokoro
# TTS_VOICE=ef_dora
# TTS_FORMAT=mp3
# STT_BASE_URL=http://127.0.0.1:8000
# STT_MODEL=Systran/faster-whisper-small
