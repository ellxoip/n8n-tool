{
  "version": 1,
  "notes": "Fuente unica de verdad de modelos. Cada rol prueba env OLLAMA_MODEL_<ROL>, luego 'preferred', luego 'fallbacks' y usa el primero que Ollama tenga instalado. Verifica los tags exactos en https://ollama.com/library antes de hacer pull.",
  "roles": {
    "supervisor": {
      "label": "Supervisor (routing rapido)",
      "preferred": "qwen3.5:4b",
      "fallbacks": ["qwen3:4b", "mistral-small:latest"],
      "numCtx": 8192,
      "required": true
    },
    "analyst": {
      "label": "Analista (razonamiento MoE)",
      "preferred": "qwen3.5:35b-a3b",
      "fallbacks": ["qwen3:30b-a3b", "deepseek-r1:14b"],
      "numCtx": 16384,
      "required": true
    },
    "programmer": {
      "label": "Programador (agentic coding MoE)",
      "preferred": "qwen3-coder-next:latest",
      "fallbacks": ["qwen3-coder:30b", "deepseek-coder-v2:16b"],
      "numCtx": 16384,
      "required": true
    },
    "reviewer": {
      "label": "Revisor QA (modelo distinto al programador)",
      "preferred": "gemma4:26b",
      "fallbacks": ["qwen3-coder:30b", "deepseek-coder-v2:16b"],
      "numCtx": 16384,
      "required": true
    },
    "devops": {
      "label": "DevOps Runtime (ligero)",
      "preferred": "qwen3.5:4b",
      "fallbacks": ["qwen3:4b", "mistral-small:latest"],
      "numCtx": 8192,
      "required": true
    },
    "vision": {
      "label": "Vision / OCR",
      "preferred": "qwen3-vl:8b",
      "fallbacks": ["qwen3-vl:4b", "qwen2.5vl:7b", "llama3.2-vision:11b"],
      "required": false
    },
    "embedding": {
      "label": "Embeddings para memoria RAG",
      "preferred": "nomic-embed-text:latest",
      "fallbacks": ["qwen3-embedding:0.6b", "mxbai-embed-large:latest"],
      "required": false
    }
  },
  "workflows": {
    "supervisor.json": { "role": "supervisor" },
    "agente_analista.json": { "role": "analyst" },
    "agente_programador.json": { "role": "programmer" },
    "agente_revisor.json": { "role": "reviewer" },
    "agente_devops.json": { "role": "devops" },
    "agente_principal.json": { "role": "supervisor" },
    "agente_terminal_coder.json": { "role": "programmer" },
    "ocr_vision.json": { "role": "vision" },
    "voz_tts.json": {},
    "voz_agente.json": { "role": "supervisor" }
  }
}
