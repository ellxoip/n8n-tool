      "id": "memory-coder",
      "name": "Memoria Coder"
    },
    {
      "parameters": {
        "name": "ejecutar_javascript",
        "description": "Ejecuta código JavaScript. Usa esta herramienta para probar y ejecutar código que has escrito. Puedes hacer cualquier operación: cálculos, manipulación de strings, arrays, objetos, llamadas async, etc.",
        "language": "javaScript",
        "jsCode": "return { result: 'Código ejecutado' };"
      },
      "type": "@n8n/n8n-nodes-langchain.toolCode",
      "typeVersion": 1.1,
      "position": [760, 560],
      "id": "tool-code-coder",
      "name": "Ejecutar JavaScript"
    },
    {
      "parameters": {
        "toolDescription": "Realiza una solicitud HTTP GET a una URL para probar endpoints o leer documentacion de APIs.",
        "method": "GET",
        "url": "{url}",
        "placeholderDefinitions": {
          "values": [
            {
              "name": "url",
              "description": "URL completa (https://...) a consultar con GET",
              "type": "string"
            }
          ]
        }
      },
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "name": "consultar_api",
      "position": [900, 560],
      "id": "tool-http-coder"
    },
    {
      "parameters": {
        "toolDescription": "Busca en la memoria compartida del equipo (documentacion del proyecto, decisiones del Analista, aprendizajes de QA, workflows previos). Usala ANTES de analizar o programar para reutilizar contexto. Devuelve fragmentos con su fuente y puntaje.",
        "method": "POST",
        "url": "http://127.0.0.1:8787/memory/search",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "keypair",
        "parametersBody": {
          "values": [
            {
              "name": "query",
              "valueProvider": "modelRequired"
            },
            {
              "name": "limit",
              "valueProvider": "fieldValue",
              "value": "5"
            }
          ]
        },
        "placeholderDefinitions": {
          "values": [
            {
              "name": "query",
              "description": "Pregunta o tema a buscar, en lenguaje natural",
              "type": "string"
            }
          ]
        }
      },
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "name": "buscar_memoria",
      "credentials": {
        "httpHeaderAuth": {
          "id": "BRIDGE_TOKEN",
          "name": "Bridge Token"
        }
      },
      "position": [1040, 560],
      "id": "tool-buscar_memoria"
    },
    {
      "parameters": {
        "toolDescription": "Guarda en la memoria compartida del equipo una decision, conclusion o aprendizaje duradero (texto autocontenido, sin secretos ni datos personales). Usala al cerrar una tarea importante.",
        "method": "POST",
        "url": "http://127.0.0.1:8787/memory/ingest",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "keypair",
        "parametersBody": {
          "values": [
            {
              "name": "text",
              "valueProvider": "modelRequired"
            },
            {
              "name": "source",
              "valueProvider": "fieldValue",
              "value": "programador"
            }
          ]
        },
        "placeholderDefinitions": {
          "values": [
            {
              "name": "text",
              "description": "Texto autocontenido a recordar (decision, hallazgo o aprendizaje)",
              "type": "string"
            }
          ]
        }
      },
      "type": "@n8n/n8n-nodes-langchain.toolHttpRequest",
      "typeVersion": 1.1,
      "name": "guardar_memoria",
      "credentials": {
